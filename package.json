{
  "name": "@kildall/peaknode-sdk-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the Peaknode Proof of Reserves API (generated from the OpenAPI spec).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kildall/peaknode-sdk-ts.git"
  },
  "homepage": "https://github.com/Kildall/peaknode-sdk-ts#readme",
  "bugs": "https://github.com/Kildall/peaknode-sdk-ts/issues",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.6.0"
  }
}
